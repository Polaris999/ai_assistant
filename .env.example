# LLM: vllm | openai | dify
LLM_TYPE=vllm
REPLY_LLM_TYPE=
# Embeddings: openai | api（单独 embedding 服务，默认 api）
EMBEDDING_TYPE=api
# 自建 embedding 服务（EMBEDDING_TYPE=api 时，需 OpenAI 兼容 /v1/embeddings）
# EMBEDDING_BASE_URL=http://your-embedding-service/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=default

# vLLM（未设 --served-model-name 时，模型名多为 --model 路径或 GET /v1/models 所列 id）
VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_CHAT_MODEL=/root/models
# VLLM_API_KEY=
# VLLM_TIMEOUT=120

# 向量库: chroma | qdrant | weaviate
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./data/chroma_db
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# WEAVIATE_URL=http://localhost:8080
# WEAVIATE_API_KEY=
# WEAVIATE_TEXT_KEY=content

# OpenAI（LLM/Embeddings 选 openai 时需 .[openai]）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Dify
# DIFY_API_KEY=
# DIFY_BASE_URL=https://api.dify.ai/v1
# DIFY_CHAT_APP_TYPE=chat-messages

# API 限制（可选）
# API_BOOK_TEXT_MAX_LENGTH=2000
# API_VOICE_MAX_BYTES=10485760

DEFAULT_REMIND_MINUTES=15
LOG_LEVEL=INFO
# PROMPT_PARSE_INTENT_PATH=
# PROMPT_REPLY_POLISH_PATH=
# LANGCHAIN_TRACING_ENABLED=false
# LANGCHAIN_PROJECT=meeting-agent

# Agent 模式：true=Tool Agent（查/订走 IMeetingService，可对接业务接口）；false=原 LangGraph 图
USE_TOOL_AGENT=true

# 会话存储：不配置则使用进程内内存；配置后使用 Redis 存储会话历史与上下文
# REDIS_HOST=172.21.234.24
# REDIS_PORT=31379
# REDIS_PASSWORD=你的密码
# REDIS_DB=0
# 或直接写连接串（优先）：REDIS_URL=redis://:你的密码@172.21.234.24:31379/0
# CONVERSATION_STORE_TTL_SECONDS=86400

# 生产可选：关闭文档、CORS
# DOCS_ENABLED=false
# CORS_ORIGINS=https://your-frontend.example.com,https://admin.example.com
