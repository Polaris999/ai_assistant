# ----- Model glue layer（业内通用：OpenAI / vLLM 自托管 / Dify）-----
# LLM for intent parsing: openai | vllm | dify
LLM_TYPE=openai
# Optional LLM for reply polish (empty = no polish)
REPLY_LLM_TYPE=
# Embeddings: openai
EMBEDDING_TYPE=openai

# OpenAI (LLM, Embeddings, Whisper)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# vLLM（自托管推理，OpenAI 兼容 API；业内常用）
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_CHAT_MODEL=Qwen2.5-7B-Instruct
# VLLM_API_KEY=

# Dify
DIFY_API_KEY=your-dify-api-key
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_CHAT_APP_TYPE=chat-messages

# RAG
CHROMA_PERSIST_DIR=./data/chroma_db

# Meeting reminder
DEFAULT_REMIND_MINUTES=15

# Logging
LOG_LEVEL=INFO

# Prompt 模板（空=使用包内默认；否则为绝对路径或相对项目根）
# PROMPT_PARSE_INTENT_PATH=
# PROMPT_REPLY_POLISH_PATH=

# 可观测：LangSmith 需额外配置 LANGCHAIN_API_KEY
# LANGCHAIN_TRACING_ENABLED=false
# LANGCHAIN_PROJECT=meeting-agent
