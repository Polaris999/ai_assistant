# LLM: vllm | openai | dify
LLM_TYPE=vllm
REPLY_LLM_TYPE=
# Embeddings: openai | api（单独 embedding 服务，默认 api）
EMBEDDING_TYPE=api
# 自建 embedding 服务（EMBEDDING_TYPE=api 时，需 OpenAI 兼容 /v1/embeddings）
# EMBEDDING_BASE_URL=http://your-embedding-service/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=default

# vLLM
VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_CHAT_MODEL=default
# VLLM_API_KEY=
# VLLM_TIMEOUT=120

# 向量库: chroma | qdrant | weaviate
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./data/chroma_db
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# WEAVIATE_URL=http://localhost:8080
# WEAVIATE_API_KEY=
# WEAVIATE_TEXT_KEY=content

# OpenAI（LLM/Embeddings 选 openai 时需 .[openai]）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Dify
# DIFY_API_KEY=
# DIFY_BASE_URL=https://api.dify.ai/v1
# DIFY_CHAT_APP_TYPE=chat-messages

DEFAULT_REMIND_MINUTES=15
LOG_LEVEL=INFO
# PROMPT_PARSE_INTENT_PATH=
# PROMPT_REPLY_POLISH_PATH=
# LANGCHAIN_TRACING_ENABLED=false
# LANGCHAIN_PROJECT=meeting-agent
