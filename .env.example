# ----- Model glue layer -----
# LLM for intent parsing: openai | dify
LLM_TYPE=openai
# Optional LLM for reply polish (empty = no polish)
REPLY_LLM_TYPE=
# Embeddings: openai (more can be added later)
EMBEDDING_TYPE=openai

# OpenAI (LLM, Embeddings, Whisper)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Dify
DIFY_API_KEY=your-dify-api-key
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_CHAT_APP_TYPE=chat-messages

# RAG
CHROMA_PERSIST_DIR=./data/chroma_db

# Meeting reminder
DEFAULT_REMIND_MINUTES=15

# Logging
LOG_LEVEL=INFO
