# profile=dev 时加载（APP_PROFILE=dev 或未设）；可与 .env 叠加，.env 优先
# LLM: vllm | openai | dify
LLM_TYPE=vllm
REPLY_LLM_TYPE=
# Embeddings: local（.[local]）| openai（OPENAI_*）| api（自建服务，用下面 EMBEDDING_*）
EMBEDDING_TYPE=api
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 自建 embedding 服务（EMBEDDING_TYPE=api 时，需 OpenAI 兼容 /v1/embeddings）
EMBEDDING_BASE_URL=http://172.16.4.28:8001/v1
EMBEDDING_API_KEY= eb2fe408-efd8-480e-aa08-a45082b1a38a
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# vLLM
VLLM_BASE_URL=http://172.16.4.28:8000/v1
VLLM_CHAT_MODEL=Qwen/qwen3-14B-awq
VLLM_API_KEY=eb2fe408-efd8-480e-aa08-a45082b1a38a
VLLM_TIMEOUT=120

# 向量库: chroma | qdrant | weaviate
VECTOR_STORE_TYPE=weaviate
CHROMA_PERSIST_DIR=./data/chroma_db
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
WEAVIATE_URL=http://172.16.4.28:8080
WEAVIATE_API_KEY=WVF5YThaHlkYwhGUSmCRgsX3tD5ngdN8pkih
WEAVIATE_TEXT_KEY=content

# OpenAI（LLM/Embeddings 选 openai 时需 .[openai]）
